# Produktions-Hinweis (siehe github-fahrplan.md Abschnitt 6): bei einer
# oeffentlich erreichbaren Installation APP_ENV=production, APP_DEBUG=false
# und APP_URL mit https:// setzen. "php artisan app:install" warnt am Anfang
# automatisch, falls das nicht der Fall ist.
APP_NAME="Viessmann Heatpump Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Bei Produktionsbetrieb ueber HTTPS auf true setzen, sonst werden Session-
# Cookies auch unverschluesselt uebertragen:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Viessmann API (siehe app.developer.viessmann-climatesolutions.com)
VIESSMANN_CLIENT_ID=
VIESSMANN_REDIRECT_URI=
VIESSMANN_SCOPE="IoT User offline_access"
VIESSMANN_INSTALLATION_ID=
VIESSMANN_GATEWAY_SERIAL=
VIESSMANN_DEVICE_ID=0
VIESSMANN_AUTH_BASE=https://iam.viessmann-climatesolutions.com/idp/v2
VIESSMANN_API_BASE=https://api.viessmann-climatesolutions.com/iot/v2

# Open-Meteo
# Nur fuer die einmalige Seed-Migration beim Umstieg von einem aelteren
# Installationsstand relevant (siehe database/migrations/2026_10_31_120000_
# seed_weather_location_settings.php). Bei einer neuen Installation leer
# lassen - der Wetter-Standort wird stattdessen unter "Einstellungen" per
# Ortsname eingerichtet (automatisches Geocoding, siehe README).
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Artisan-Runner (nur fuer Webspace ohne SSH/Shell-Zugriff, z. B. ALL-INKL,
# siehe README "Deployment auf Webspace ohne SSH"). Leer lassen = Endpoint
# /system/run/{command} bleibt deaktiviert (404). Fuer den Produktivbetrieb
# ein langes, zufaelliges Token setzen, z. B.:
#   php artisan tinker --execute="echo bin2hex(random_bytes(32));"
ARTISAN_RUNNER_TOKEN=

# MCP-Server (rein lesender Zugriff auf die Anlagendaten für Claude & Co.,
# Endpoint POST /mcp, siehe README "MCP-Anbindung"). Leer lassen = Endpoint
# deaktiviert (404). Für die Nutzung ein langes, zufälliges Token setzen
# (mindestens 32 Zeichen), z. B.:
#   php artisan tinker --execute="echo bin2hex(random_bytes(32));"
# Dieses Token ist bewusst ein anderes als ARTISAN_RUNNER_TOKEN.
MCP_API_TOKEN=
